// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AgentRole {
  ADMIN
  AGENT
}

enum TicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Channel {
  EMAIL
  CHAT
  WEB_FORM
}

enum MessageAuthor {
  CUSTOMER
  AGENT
  SYSTEM
}

enum DraftStatus {
  GENERATED
  APPROVED
  DISCARDED
}

model Agent {
  id        String    @id @default(cuid())
  clerkId   String    @unique
  name      String
  email     String    @unique
  avatarUrl String?
  role      AgentRole @default(AGENT)
  createdAt DateTime  @default(now())

  tickets  Ticket[]
  messages Message[]
  drafts   AiDraft[]
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  company   String?
  plan      String   @default("Free")
  avatarUrl String?
  notes     String?
  createdAt DateTime @default(now())

  tickets Ticket[]
}

model Ticket {
  id            String       @id @default(cuid())
  number        Int          @unique @default(autoincrement())
  subject       String
  status        TicketStatus @default(OPEN)
  priority      Priority     @default(MEDIUM)
  channel       Channel      @default(EMAIL)
  tags          String[]
  customerId    String
  assigneeId    String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  lastMessageAt DateTime     @default(now())

  customer Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignee Agent?      @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  messages Message[]
  drafts   AiDraft[]

  @@index([status, priority])
  @@index([assigneeId])
  @@index([customerId])
  @@index([lastMessageAt(sort: Desc)])
}

model Message {
  id         String        @id @default(cuid())
  ticketId   String
  authorType MessageAuthor
  agentId    String?
  body       String
  createdAt  DateTime      @default(now())

  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  agent       Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)
  sourceDraft AiDraft?

  @@index([ticketId, createdAt])
}

model KnowledgeArticle {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  category  String
  content   String
  createdAt DateTime @default(now())

  draftSources DraftSource[]
}

model AiDraft {
  id            String      @id @default(cuid())
  ticketId      String
  createdById   String?
  body          String
  status        DraftStatus @default(GENERATED)
  model         String      @default("gemini")
  sentMessageId String?     @unique
  createdAt     DateTime    @default(now())

  ticket      Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  createdBy   Agent?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  sentMessage Message?      @relation(fields: [sentMessageId], references: [id], onDelete: SetNull)
  sources     DraftSource[]

  @@index([ticketId, createdAt])
}

model DraftSource {
  id        String @id @default(cuid())
  draftId   String
  articleId String
  snippet   String
  relevance Float  @default(0)
  position  Int    @default(0)
  draft   AiDraft          @relation(fields: [draftId], references: [id], onDelete: Cascade)
  article KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([draftId])
}